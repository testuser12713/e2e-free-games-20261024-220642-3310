{
  "runcontract": 1,
  "services": [
    {
      "name": "api",
      "dir": "backend",
      "stack": "python",
      "kind": "server",
      "install": [
        ["${python}", "-m", "pip", "install", "-q", "-r", "requirements.txt"]
      ],
      "start": [
        "${python}", "-m", "uvicorn", "app.main:app",
        "--host", "127.0.0.1", "--port", "${PORT}", "--no-access-log"
      ],
      "port": 8000,
      "port_env": "PORT",
      "health": { "path": "/api/health", "expect_status": [200] },
      "env": {
        "DATABASE_PATH": { "dev": "data/games.db" },
        "CORS_ORIGINS": { "dev": "${service:web.origin}" },
        "REFRESH_INTERVAL_HOURS": { "dev": "6" },
        "SCRAPE_ON_START": { "dev": "true" }
      },
      "test": [
        ["${python}", "-m", "pytest"]
      ],
      "lint": [
        ["${python}", "-m", "ruff", "format", "--check", "."],
        ["${python}", "-m", "ruff", "check", "."]
      ],
      "seed": [
        ["${python}", "-m", "app.seed"]
      ]
    },
    {
      "name": "tasks",
      "dir": ".",
      "stack": "c",
      "kind": "library",
      "install": [
        ["make", "install"]
      ],
      "test": [
        ["make", "test"]
      ]
    }
  ]
}
